```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>sara_no3 — Watch</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --purple: #9147ff;
            --purple-dark: #6f32c9;
            --background: #07070a;
            --panel: rgba(16, 16, 23, 0.94);
            --border: rgba(255,255,255,0.08);
            --text: #ffffff;
            --muted: #9999a6;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 20% 0%, rgba(145,71,255,.18), transparent 30%),
                radial-gradient(circle at 90% 20%, rgba(145,71,255,.10), transparent 30%),
                var(--background);
            color: var(--text);
            font-family: Arial, Helvetica, sans-serif;
        }

        /* =========================
           BARRA SUPERIOR
        ========================= */

        header {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 64px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 24px;

            background: rgba(8,8,12,.92);
            backdrop-filter: blur(14px);

            border-bottom: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 21px;
            font-weight: 800;
        }

        .brand-icon {
            width: 34px;
            height: 34px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: var(--purple);
            border-radius: 9px;

            font-size: 18px;
        }

        .brand span {
            color: var(--purple);
        }

        .live-status {
            display: flex;
            align-items: center;
            gap: 8px;

            font-size: 13px;
            font-weight: bold;
            color: #ff4d5a;
        }

        .live-dot {
            width: 8px;
            height: 8px;

            border-radius: 50%;
            background: #ff4d5a;

            box-shadow: 0 0 10px rgba(255,77,90,.7);
        }

        /* =========================
           CONTENEDOR
        ========================= */

        main {
            width: 100%;
            max-width: 1700px;
            margin: auto;
            padding: 22px;
        }

        /* =========================
           STREAM
        ========================= */

        .watch-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;

            gap: 14px;

            min-height: calc(100vh - 110px);
        }

        .video-wrapper {
            position: relative;

            width: 100%;
            aspect-ratio: 16 / 9;

            background: #000;

            border-radius: 12px;
            overflow: hidden;

            border: 1px solid var(--border);

            box-shadow:
                0 25px 70px rgba(0,0,0,.45);
        }

        .video-wrapper iframe {
            width: 100%;
            height: 100%;

            border: 0;
        }

        /* =========================
           CHAT
        ========================= */

        .chat-wrapper {
            height: 100%;
            min-height: 600px;

            background: var(--panel);

            border: 1px solid var(--border);
            border-radius: 12px;

            overflow: hidden;

            box-shadow:
                0 20px 60px rgba(0,0,0,.35);
        }

        .chat-header {
            height: 50px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 16px;

            background: rgba(255,255,255,.025);

            border-bottom: 1px solid var(--border);

            font-size: 14px;
            font-weight: bold;
        }

        .chat-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .chat-title::before {
            content: "";
            width: 7px;
            height: 7px;

            border-radius: 50%;
            background: var(--purple);
        }

        .chat-wrapper iframe {
            width: 100%;
            height: calc(100% - 50px);

            border: 0;
        }

        /* =========================
           INFORMACIÓN
        ========================= */

        .channel-card {
            margin-top: 16px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            padding: 20px;

            background: var(--panel);

            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .channel-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .avatar {
            width: 58px;
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;

            background:
                linear-gradient(135deg, #9147ff, #5c25a8);

            border-radius: 50%;

            font-size: 20px;
            font-weight: bold;

            box-shadow:
                0 0 25px rgba(145,71,255,.25);
        }

        .channel-name {
            font-size: 20px;
            font-weight: 800;
        }

        .channel-description {
            margin-top: 5px;

            color: var(--muted);

            font-size: 13px;
        }

        .watch-button {
            padding: 11px 18px;

            background: var(--purple);

            color: white;

            border-radius: 8px;

            text-decoration: none;

            font-size: 14px;
            font-weight: bold;

            transition: .2s;
        }

        .watch-button:hover {
            background: #772ce8;
            transform: translateY(-1px);
        }

        /* =========================
           REDES
        ========================= */

        .socials {
            margin-top: 14px;

            display: flex;
            gap: 10px;

            flex-wrap: wrap;
        }

        .social {
            padding: 9px 14px;

            background: rgba(255,255,255,.05);

            border: 1px solid var(--border);
            border-radius: 7px;

            color: #ccc;

            text-decoration: none;

            font-size: 13px;

            transition: .2s;
        }

        .social:hover {
            background: rgba(145,71,255,.15);
            border-color: rgba(145,71,255,.4);
            color: white;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 25px;

            text-align: center;

            color: #666;

            font-size: 12px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 1000px) {

            .watch-layout {
                grid-template-columns: 1fr;
            }

            .chat-wrapper {
                min-height: 500px;
                height: 500px;
            }

            .channel-card {
                align-items: flex-start;
                flex-direction: column;
            }

        }

        @media (max-width: 600px) {

            header {
                padding: 0 14px;
            }

            main {
                padding: 10px;
            }

            .brand {
                font-size: 17px;
            }

            .live-status {
                font-size: 11px;
            }

            .channel-card {
                padding: 15px;
            }

            .channel-name {
                font-size: 18px;
            }

            .watch-button {
                width: 100%;
                text-align: center;
            }

        }
    </style>
</head>

